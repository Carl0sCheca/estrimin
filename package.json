{
  "name": "estrimin-web",
  "version": "3.1.1",
  "private": true,
  "target": "ES2017",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "test": "vitest",
    "generate": "pnpm prisma generate",
    "build": "next build",
    "start": "next start",
    "prod:start": "pnpm prisma migrate deploy && tsx src/scripts/startup.ts && next start",
    "lint": "eslint .",
    "startup": "tsx src/scripts/startup.ts",
    "buildandstart": "pnpm prisma generate && npx prisma migrate deploy && tsx src/scripts/startup.ts && next build && next start",
    "build:scheduler": "esbuild scheduler/src/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/scheduler/index.js --external:@prisma/client --external:zeromq --tsconfig=scheduler/tsconfig.json",
    "start:scheduler": "node ./dist/scheduler/index.js",
    "dev:scheduler": "tsx watch scheduler/src/index.ts",
    "buildandstart:scheduler": "pnpm build:scheduler && pnpm start:scheduler"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.8",
    "ffmpeg-stream": "^1.0.1",
    "mp4box": "^2.4.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "toad-scheduler": "^4.2.0",
    "uuid": "^14.0.3",
    "whep-player": "git://github.com/Carl0sCheca/whep-player-lib.git#fd34c0ab23a4a06b474f329cbc30ea81d96cd4e9",
    "zeromq": "^6.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "baseline-browser-mapping": "^2.11.30",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}